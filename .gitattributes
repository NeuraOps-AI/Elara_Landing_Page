# Keep source portable and preserve media byte-for-byte.
* text=auto
*.js text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.html text eol=lf
*.css text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.py text eol=lf
*.cmd text eol=crlf
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.mp4 binary
*.woff2 binary
